+// Stable object/allocation identities remain valid after Vulkan handles are destroyed.
+template<typename T>
+static Json::Value memory_binding(const T& object, const char* kind)
+{
+	Json::Value value = json_base(object);
+	value["kind"] = kind;
+	if (object.memory)
+	{
+		value["allocation_uid"] = object.memory->uid;
+		value["memory_type_index"] = object.memory->memoryTypeIndex;
+		value["memory_offset"] = (Json::UInt64)object.memoryOffset;
+	}
+	return value;
 }
 
