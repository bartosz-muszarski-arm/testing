+// Basic Vulkan eligibility rules shared by existing-resource and maintenance4 queries.
+static uint32_t compatible_memory_type_bits(cVkDevice* dev, bool protected_resource, bool transient_image)
+{
+	uint32_t bits = 0;
+	const auto& properties = dev->physicalDevice->memoryProperties;
+	for (uint32_t i = 0; i < properties.memoryTypeCount; ++i)
+	{
+		const VkMemoryPropertyFlags flags = properties.memoryTypes[i].propertyFlags;
+		if (bool(flags & VK_MEMORY_PROPERTY_PROTECTED_BIT) != protected_resource) continue;
+		if ((flags & VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT) && !transient_image) continue;
+		bits |= 1u << i;
+	}
+	return bits;
+}
